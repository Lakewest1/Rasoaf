# Security Headers for Rasoaf Travels
/*
  # CRITICAL: HSTS (Forces HTTPS - Start with 1 day for testing)
  Strict-Transport-Security: max-age=3600; includeSubDomains

  # CRITICAL: CSP (Prevents XSS attacks)
  Content-Security-Policy: 
    default-src 'self';
    script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://www.google.com https://formspree.io;
    style-src 'self' 'unsafe-inline' https://fonts.googleapis.com;
    img-src 'self' data: https://res.cloudinary.com https://images.unsplash.com;
    font-src 'self' https://fonts.gstatic.com;
    connect-src 'self' https://api.netlify.com https://formspree.io https://formspree.io/f/*;
    frame-src 'self' https://www.google.com;
    base-uri 'self';
    form-action 'self' https://formspree.io;
    upgrade-insecure-requests;

  # Prevent clickjacking
  X-Frame-Options: DENY

  # Prevent MIME type sniffing
  X-Content-Type-Options: nosniff

  # Privacy protection
  Referrer-Policy: strict-origin-when-cross-origin

  # Restrict browser features
  Permissions-Policy: geolocation=(), microphone=(), camera=()