# ============================================
# RASOAF TRAVELS & TOURS - SECURITY HEADERS
# ============================================

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Cross-Origin-Opener-Policy: same-origin

# ============================================
# SECURITY POLICY
# ============================================

  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://www.google.com https://formspree.io https://static.cloudflareinsights.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://res.cloudinary.com https://*.cloudinary.com https://images.unsplash.com https://*.googleapis.com https://flagcdn.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://api.netlify.com https://formspree.io https://*.cloudinary.com; frame-src 'self' https://www.google.com; media-src 'self' https://res.cloudinary.com https://*.cloudinary.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://formspree.io; upgrade-insecure-requests

# ============================================
# STATIC ASSETS
# ============================================

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ============================================
# 3D TEXTURES
# ============================================

/textures/*
  Cache-Control: public, max-age=31536000, immutable

# ============================================
# INDIVIDUAL IMAGE TYPES
# ============================================

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.gif
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

# ============================================
# HTML
# ============================================

/*.html
  Cache-Control: no-cache, no-store, must-revalidate